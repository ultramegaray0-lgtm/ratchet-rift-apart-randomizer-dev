+def default_scripts(game):
+    for d in ([os.path.join(game, "scripts")] if game else []) + [os.path.join(HERE, "..", "..", "scripts")]:
+        if os.path.isfile(os.path.join(d, "16_rando_spawners.lua")):
+            return os.path.abspath(d)
+    return None
+
